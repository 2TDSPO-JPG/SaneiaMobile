# URL da API Java. No celular, troque localhost pelo IP do computador.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Persistência no dispositivo para a disciplina Mobile. Ative apenas com API_URL vazia.
EXPO_PUBLIC_LOCAL_MODE=false
# Integração opcional com a ponte Wokwi no ambiente local.
EXPO_PUBLIC_IOT_URL=
EXPO_PUBLIC_IOT_DEMO_TOKEN=
# Porta da ponte no mesmo computador, quando a URL do app termina em /__saneia_iot.
SANEIA_IOT_UPSTREAM_PORT=
